<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exportador manual del paquete del jugador: exporta los monstruos de una grabación (de cualquier ranura, también
       de antes de instalar el Rancho) con el mismo formato que "Rivales Kokemon" al guardar. Comparte el código de
       exportación con ese mod. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>..\archivos\icono.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputPath>build\exportador</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\mods\Leagues\MRDX.Custom.Leagues\LeagueMonster.cs" Link="Compartido\LeagueMonster.cs" />
    <Compile Include="..\..\mods\Leagues\MRDX.Custom.Leagues\Exportacion.cs" Link="Compartido\Exportacion.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MRDX.Base.Mod.Interfaces">
      <HintPath>..\..\mods\Leagues\lib\MRDX.Base.Mod.Interfaces.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
