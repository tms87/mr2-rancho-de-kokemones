<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EditorKokemon</AssemblyName>
    <ApplicationIcon>..\..\instalador\archivos\icono.ico</ApplicationIcon>
    <OutputPath>build</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- T("espaÃ±ol", "english"): textos en el idioma de la liga. -->
    <Using Include="EditorKokemon.Textos" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lee WebP (muchas IA guardan WebP con extension .png), PNG, JPG, etc. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
